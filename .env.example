# ============================================================
# qoder-proxy-api 环境变量示例
# 用法：复制本文件为 .env（启动时自动加载），填入真实值。
# .env 已被 .gitignore 忽略，切勿把真实 token 提交进仓库。
# 完整语义见 docs/09-环境变量与启动配置.md 与 README「环境变量」节。
# ============================================================

# ---------- 必填：Qoder Cloud Agents 三元组 + 下游鉴权 ----------

# Qoder 官方 PAT/SAT 访问令牌（也可用别名 QODER_PERSONAL_ACCESS_TOKEN）
QODER_ACCESS_TOKEN=qoder_pat_xxxxxxxxxxxxxxxx

# Qoder Cloud Agent 的 Agent ID
QODER_AGENT_ID=agent_xxxxxxxxxxxxxxxx

# Qoder Cloud Agent 的环境 ID
QODER_ENVIRONMENT_ID=env_xxxxxxxxxxxxxxxx

# 下游客户端（CC Switch / Claude Code / OpenAI SDK 等）调用本代理时使用的鉴权 key
# （也可用别名 QODER_PROXY_API_KEY）
PROXY_API_KEY=local-dev-key

# ---------- 服务监听（可选，以下为默认值） ----------

# 监听地址，默认 127.0.0.1
#HOST=127.0.0.1
# 监听端口，默认 8320（也可用 QODER_PROXY_PORT）
#PORT=8320

# ---------- 模型（可选） ----------

# 单模型模式：客户端可见的模型名，默认 qoder-agent-default
#（也可用 QODER_DEFAULT_MODEL）
#QODER_MODEL_ID=qoder-agent-default
# 固定 Agent 版本（数字字符串），一般留空
#QODER_AGENT_VERSION=
# 会话标题前缀，默认 Qoder Proxy API session
#QODER_SESSION_TITLE=

# 多模型模式：JSON 对象，key 为客户端可见模型名。
# 设置后覆盖上面的单模型三元组（QODER_MODEL_ID/QODER_AGENT_ID/QODER_ENVIRONMENT_ID）。
# 也可用别名 QODER_MODELS_JSON。
#QODER_MODEL_MAP={"gpt-style":{"agentId":"agent_aaa","environmentId":"env_aaa"},"claude-style":{"agentId":"agent_bbb","environmentId":"env_bbb","agentVersion":3,"title":"Claude 风格会话"}}

# ---------- 上游与行为（可选，以下为默认值） ----------

# Qoder Cloud Agents API 地址（自动补全 /api/v1/cloud 后缀）
#QODER_API_BASE_URL=https://api.qoder.com/api/v1/cloud
# 上游请求超时，毫秒，默认 600000（10 分钟）
#QODER_REQUEST_TIMEOUT_MS=600000
# 无 session key 的请求完成后是否归档 Qoder Session（true/1/yes/on）
#QODER_ARCHIVE_EPHEMERAL=true
# x-qoder-session-id 复用缓存时长，毫秒，默认 7200000（2 小时）
#QODER_SESSION_TTL_MS=7200000
