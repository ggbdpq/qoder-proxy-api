# qoder-proxy-api 环境变量模板
# 用法：复制本文件为 .env 即可运行（Gateway 链路只需替换 QODER_GATEWAY_PAT 为你的真实令牌）。
# .env 已被 .gitignore 忽略，切勿提交或分享；示例中的密钥均为打码样例。

# ============================================================
# 服务监听与下游鉴权（所有 Provider 共用）
# ============================================================
# 监听地址，默认只绑定 loopback
HOST=127.0.0.1
# 监听端口
PORT=8320
# 下游客户端（CC Switch / Claude Code 等）调用本代理时使用的 key
PROXY_API_KEY=qpa_6CBG-4duc_x24qisVEObmbZv

# ============================================================
# Provider：Gateway（npm start 默认链路，实验性）
# ============================================================
# 令牌来源：https://qoder.cn/account/integrations （国内站「服务集成」→ 创建个人访问令牌，格式 pt-xxxx_...）
# Gateway 链路的个人访问令牌，缺失时启动即报错
QODER_GATEWAY_PAT=pt-WMuRnspO0KmHYGTZlkwUdKqv_01a0ed7f-xxxx-xxxx-xxxx-33bca2013491
# 未指定模型时的默认模型（限免：Qwen3.8-Flash）
QODER_GATEWAY_DEFAULT_MODEL=Qwen3.8-Flash

# ============================================================
# Provider：Cloud Agents（npm run start:cloud-agents）
# ============================================================
# 令牌来源：https://qoder.com/account/integrations （「Integrations」→ Personal Access Tokens，格式 pt-xxxx_...）
# Cloud Agents API 的 PAT/SAT
QODER_ACCESS_TOKEN=pt-aXRhU9uxxxx11c8
# Cloud Agent 的 Agent ID
QODER_AGENT_ID=agent_00puxxxxwtvz
# Cloud Agent 的环境 ID
QODER_ENVIRONMENT_ID=env_00pu43xxxxtw9t
# 单模型模式下的客户端可见模型名
QODER_MODEL_ID=qoder-agent-default

# ============================================================
# 可选扩展（按需取消注释；上面两段填完即可运行）
# ============================================================

# ---------- 切换默认 Provider ----------
# gateway | cli | cloudAgents；npm start 默认 gateway，
# 也可用 npm run start:cli / start:cloud-agents 或 --provider= 切换
#QODER_DEFAULT_PROVIDER=gateway

# ---------- Gateway 补充项 ----------
# 区域端点，目前仅 cn
#QODER_GATEWAY_REGION=cn
# 模型目录缓存 TTL，毫秒
#QODER_GATEWAY_MODEL_CACHE_TTL_MS=600000

# ---------- CLI（npm run start:cli） ----------
# qodercli 可执行文件；Windows npm .cmd shim 无法无 shell 启动时，
# 把 QODER_CLI_BIN 指向包内真实 cli.js 入口并设 QODER_CLI_NODE=node
#QODER_CLI_BIN=qodercli
#QODER_CLI_NODE=
# CLI model level（ultimate 等）；留空走 CLI 默认路由
#QODER_CLI_MODEL=
# 子进程工作目录；留空用代理进程 cwd
#QODER_CLI_WORKSPACE=
# 子进程超时，毫秒
#QODER_CLI_TIMEOUT_MS=600000

# ---------- Cloud Agents 补充项 ----------
# 固定 Agent 版本（数字字符串），一般留空
#QODER_AGENT_VERSION=
# 会话标题前缀，默认 Qoder Proxy API session
#QODER_SESSION_TITLE=
# 多模型模式：JSON 对象，key 为客户端可见模型名（覆盖单模型三元组）
#QODER_MODEL_MAP={"qoder-cc":{"agentId":"agent_xxx","environmentId":"env_xxx"}}
# Cloud API base（自动补全 /api/v1/cloud 后缀）
#QODER_API_BASE_URL=https://api.qoder.com/api/v1/cloud
# 上游请求超时，毫秒
#QODER_REQUEST_TIMEOUT_MS=600000
# 无会话 key 的请求完成后是否归档 Qoder Session（true/1/yes/on）
#QODER_ARCHIVE_EPHEMERAL=true
# 会话复用缓存 TTL，毫秒
#QODER_SESSION_TTL_MS=7200000

# ---------- 显式模型路由 ----------
# JSON：客户端别名 → { "provider", "model" }；未命中的模型名直通默认 Provider
#QODER_MODEL_ROUTES={"qoder-cc":{"provider":"cloudAgents","model":"qoder-cc"},"qoder-qwen":{"provider":"gateway","model":"Qwen3.8-Flash"}}
