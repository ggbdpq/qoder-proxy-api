{
  "name": "qoder-proxy-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local protocol gateway exposing OpenAI/Anthropic-compatible APIs over three Qoder providers (gateway / cli / cloud-agents).",
  "bin": {
    "qoder-proxy-api": "./src/index.js"
  },
  "scripts": {
    "start": "node ./src/index.js --provider=gateway",
    "start:cli": "node ./src/index.js --provider=cli",
    "start:cloud-agents": "node ./src/index.js --provider=cloud-agents",
    "test": "node --test",
    "setup:cloudAgents": "node ./scripts/setupCloudAgents.mjs",
    "doctor": "node ./scripts/doctor.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "UNLICENSED"
}
