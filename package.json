{
  "name": "qoder-proxy-api",
  "version": "0.2.2",
  "private": true,
  "description": "Local protocol gateway exposing OpenAI/Anthropic-compatible APIs over three Qoder providers (gateway / cli / cloud-agents).",
  "license": "MIT",
  "bin": {
    "qoder-proxy-api": "./src/index.ts"
  },
  "type": "module",
  "scripts": {
    "start": "node ./src/index.ts --provider=gateway",
    "start:cli": "node ./src/index.ts --provider=cli",
    "start:cloud-agents": "node ./src/index.ts --provider=cloud-agents",
    "test": "node --test",
    "demo": "node ./scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "setup:cloudAgents": "node ./scripts/setupCloudAgents.ts",
    "doctor": "node ./scripts/doctor.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.6.0"
}
